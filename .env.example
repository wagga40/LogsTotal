# ╔══════════════════════════════════════════════════════════════════╗
# ║  MINIMUM REQUIRED CHANGES before first run:                     ║
# ║  1. SECRET_KEY     — generate one (see below)                   ║
# ║  2. ADMIN_EMAIL    — your admin login email                     ║
# ║  3. ADMIN_PASSWORD — strong password (not changeme123)          ║
# ║  Everything else has safe defaults for local dev and Docker.    ║
# ║                                                                  ║
# ║  Tip: `./logstotal gen-secrets -- --write` fills SECRET_KEY and every  ║
# ║  other secret (DB / Redis / S3 / Garage) in this file at once,  ║
# ║  touching only keys that are still empty or a placeholder.      ║
# ╚══════════════════════════════════════════════════════════════════╝

# Application
# SECRET_KEY must be changed before first run — it signs all JWTs/sessions.
# Generate everything at once with: ./logstotal gen-secrets -- --write
# Or just this one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=false
# Set COOKIE_INSECURE=true when using plain HTTP with DEBUG=false (e.g. Docker on port 8000
# without the proxy profile). Otherwise the session cookie is Secure and the browser will not
# send it, so login looks broken.
# COOKIE_INSECURE=false

# Disable Content-Security-Policy header (useful when testing via IP without a domain)
# DISABLE_CSP=false

# Admin bootstrap (used by init_db.py only — not stored in DB).
# init REFUSES the shipped default below (and any password under 8 characters) —
# set a strong one, or let `./logstotal gen-secrets -- --write` generate it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Docker Compose Profiles ────────────────────────────────────────────
#
# Comma-separated list of optional services to enable in Docker.
# Available profiles:
#   postgres — PostgreSQL instead of SQLite (requires POSTGRES_PASSWORD below)
#   s3       — Garage S3-compatible object storage (requires STORAGE_BACKEND=s3 below)
#   proxy    — Caddy reverse proxy with automatic HTTPS (requires DOMAIN below)
#   workers  — expose Redis on the network for remote Huey workers (requires REDIS_EXPOSE below)
#               Multi-worker mode also requires shared PostgreSQL + STORAGE_BACKEND=s3.
#
# Examples:
#   COMPOSE_PROFILES=postgres
#   COMPOSE_PROFILES=s3
#   COMPOSE_PROFILES=postgres,s3,proxy
#   COMPOSE_PROFILES=postgres,s3,workers
#
# COMPOSE_PROFILES=

# ── Database ──────────────────────────────────────────────────────────────
#
# When DATABASE_URL is unset the app defaults to SQLite (local dev: ./logstotal.db,
# Docker: /data/logstotal.db) — most deployments need no DATABASE_URL at all.
# Only set it for local PostgreSQL or a custom SQLite path. Keep it commented for
# Docker PostgreSQL: an uncommented SQLite line here would otherwise shadow the
# postgres profile (the entrypoint detects the legacy template value and warns).
#   SQLite (explicit — same as the default):
# DATABASE_URL=sqlite+aiosqlite:///./logstotal.db
#   PostgreSQL (local development without Docker — uncomment and adjust):
#     DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/logstotal
#     SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/logstotal
#   SYNC_DATABASE_URL is auto-derived from DATABASE_URL if not set.
#
# DOCKER (./logstotal docker:up) — the entrypoint auto-detects the database:
#   1. DATABASE_URL set → preserved for Postgres / absolute SQLite paths / remote workers.
#      Relative SQLite URLs (sqlite+aiosqlite:///./logstotal.db) are rewritten to
#      sqlite+aiosqlite:////data/logstotal.db so the DB lives on the ./data volume.
#   2. PostgreSQL — engaged only when POSTGRES_PASSWORD is set AND the bundled service
#      is in play: "postgres" is in COMPOSE_PROFILES above, OR an external POSTGRES_HOST
#      is set. COMPOSE_PROFILES is the reference — a POSTGRES_PASSWORD alone (e.g. one
#      `./logstotal gen-secrets -- --write` appended) does NOT switch to PostgreSQL; the app
#      stays on SQLite and prints a warning instead of waiting for a postgres host
#      compose never started. Set POSTGRES_HOST / DATABASE_URL to point at an external
#      PostgreSQL without the bundled service.
#   3. Otherwise → SQLite at /data/logstotal.db (bind-mounted from ./data)
#   For the bundled PostgreSQL, add "postgres" to COMPOSE_PROFILES above and set
#   POSTGRES_PASSWORD below.
#
# POSTGRES_PASSWORD=set-a-strong-password
# POSTGRES_USER=logstotal       # optional, defaults to logstotal
# POSTGRES_DB=logstotal         # optional, defaults to logstotal
# POSTGRES_HOST=postgres        # optional, defaults to the compose service name
# POSTGRES_PORT=5432            # optional, defaults to 5432
#
# PostgreSQL connection pool tuning (applies to both local and Docker PostgreSQL; ignored when using SQLite).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=300
#
#   Avoid # @ % ? in POSTGRES_PASSWORD or URL-encode them (e.g. @ → %40).
#
# Multi-worker: expose PostgreSQL to remote workers via socat relay (requires "workers" profile).
# POSTGRES_EXPOSE=10.0.123.1:5432
#
# Run Alembic migrations automatically at startup (web/init only, never workers).
# Set false only as an escape hatch while investigating a failed migration.
# AUTO_MIGRATE=true

# ── Redis / Huey ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Docker overrides REDIS_HOST to "redis" automatically — no change needed here.
# Full Redis connection URL — overrides REDIS_HOST/REDIS_PORT/REDIS_PASSWORD when set.
# REDIS_URL=redis://10.0.0.1:6379
#
# DOCKER (single-server): Redis is NOT exposed outside Docker — web and worker
# connect via the internal Docker network. No configuration needed.
#
# DOCKER (multi-worker over WireGuard): add "workers" to COMPOSE_PROFILES above,
# then set REDIS_EXPOSE to the WireGuard interface IP and a password:
#   REDIS_EXPOSE=10.0.123.1:6379
#   REDIS_PASSWORD=set-a-strong-password
# A non-loopback REDIS_EXPOSE without REDIS_PASSWORD refuses to start.
# Control plane note: remote workers also require COMPOSE_PROFILES=postgres,s3,workers
# plus POSTGRES_PASSWORD and STORAGE_BACKEND=s3 on the main server.
# See also POSTGRES_EXPOSE (Database section) and GARAGE_EXPOSE (Storage section).
# Tip: ./logstotal deploy:env-scaffold writes ready-to-edit control-plane + worker .env files with these EXPOSE lines pre-filled.
# REDIS_EXPOSE=127.0.0.1:6379

# Huey worker threads per process. Main docker-compose.yml defaults to 2; docker-compose.worker.yml defaults to 4 for dedicated machines.
# Sizing HUEY_WORKERS / TOOL_MAX_WORKERS / per-tool threads: see docs/scaling.md.
HUEY_WORKERS=2

# Log verbosity for the app, uvicorn AND the Huey worker (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Log line format: `text` (human) or `json` (one object per line, for a log shipper).
# Both processes honour it. Correlation fields (request_id, job_id) ride on every line.
# LOG_FORMAT=text

# Emit one structured access line per request, with status and duration. Off by default;
# /static/ and /health are never logged either way. The correlation id is set regardless.
# REQUEST_LOG_ENABLED=false

# How long activity-log rows are kept, in days. `0` keeps them forever — deliberate, since
# some deployments must retain an audit trail for a fixed period. Capture itself is a
# runtime toggle on /admin/settings, not an env var.
# ACTIVITY_RETENTION_DAYS=90

# How long finished background-task rows (backfills, cleanups, recalculations) are kept.
# BACKGROUND_TASK_RETENTION_DAYS=30

# Age at which an uploaded log file AND its jobs are deleted. **0 (off) by default**,
# unlike every other retention window here: the others remove derived data, this removes
# the evidence a user submitted, so it has to be switched on deliberately.
# UPLOAD_RETENTION_DAYS=0

# ── Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500

# Storage backend: "local" (default, files in UPLOAD_DIR) or "s3" (S3-compatible).
# For the bundled Garage S3, add "s3" to COMPOSE_PROFILES above to start the service.
# docker-compose.yml defaults S3_ENDPOINT to the bundled http://garage:3900 inside
# containers, but an S3_ENDPOINT set here WINS — set it to point at an external
# S3-compatible store without the "s3" profile. For local (non-Docker) development
# with the bundled Garage, keep the localhost endpoint below.
# Multi-worker deployments must set STORAGE_BACKEND=s3 on the control plane too.
#
# Garage access keys use GK-prefixed format (26 chars) and hex secret (64 chars).
# Generate these (and all other secrets) with: ./logstotal gen-secrets -- --write
# Or individually:
#   python3 -c "import secrets; print(f'GK{secrets.token_hex(12)}')"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:3900
# S3_BUCKET=logstotal
# S3_ACCESS_KEY=GKa1b2c3d4e5f6a7b8c9d0e0f1
# S3_SECRET_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
# S3_REGION=logstotal
#
# Garage internal secrets (only needed when running the bundled Garage service).
# Defaults are baked into garage-entrypoint.sh — override for exposed deployments.
# Generate with: ./logstotal gen-secrets -- --write  (or: python3 -c "import secrets; print(secrets.token_hex(32))")
# GARAGE_RPC_SECRET=<64-char-hex-secret>
# GARAGE_ADMIN_TOKEN=<random-token>
#
# Multi-worker: expose Garage S3 to remote workers via socat relay (requires "workers" profile).
# GARAGE_EXPOSE=10.0.123.1:3900

# Analytics entity extraction (job detail view). Field-name config YAML path.
# Default: config/analytics_fields.yaml (relative to process cwd).
# ANALYTICS_FIELDS_PATH=/etc/logstotal/analytics_fields.yaml

# Threat detection heuristic patterns YAML path.
# Default: config/threat_detection.yaml (relative to process cwd).
# THREAT_DETECTION_CONFIG_PATH=config/threat_detection.yaml

# Docker host workdir — used by workers to mount host paths into sibling tool containers.
# Auto-set to $PWD in docker-compose.yml; override only if docker compose is run from a different directory.
# DOCKER_HOST_WORKDIR=   # host path matching /app when using Docker-based tools; compose sets ${PWD} for workers

# Worker tuning — concurrency model (HUEY_WORKERS / TOOL_MAX_WORKERS / per-tool threads): see docs/scaling.md.
# A registry to pull images from instead of Docker Hub — for a network with no route to
# it that runs a mirror of its own. Applied to every image LogsTotal does not build:
# the compose services, and the tool images named in workflows/*.yml.
#   REGISTRY_PREFIX=registry.internal   -> registry.internal/wagga40/zircolite:3.8.1@sha256:...
# Image digests are preserved, so a pull through a mirror is verified exactly as a pull
# from the origin would be. An image that already names a registry is left alone.
# Empty by default. For a network with NO registry at all, use `./logstotal bundle` instead.
# REGISTRY_PREFIX=
# TOOL_MAX_WORKERS=2   # per-job cap on parallel tool subprocesses; only applies when parallel_execution is on (default 2)
# MAX_LOG_OUTPUT_BYTES=51200   # cap on stored stdout/stderr per task result (default 50 KB)
# HUEY_QUEUE_EXPIRY=1800   # queue expiry: tasks not started within this many seconds are discarded (default 30 min). Does not kill running tasks.
# WORKER_NAME=worker-eu-west-1   # optional friendly fleet label
# WORKER_IP=10.0.123.2           # optional advertised IP for /admin/workers
# WORKER_HEARTBEAT_TTL=60   # seconds before a heartbeat key expires in Redis (default 60)
# WORKER_HEARTBEAT_INTERVAL=30   # seconds between heartbeat refreshes (default 30)
# WORKER_ALIVE_TTL=180       # seconds before an idle worker drops off the fleet page (default 180)

# Job output retention — age at which a job's raw tool outputs are removed, by the daily
# sweep and by "Output cleanup" (POST /admin/cleanup-outputs). Findings, analytics and the
# events timeline survive; what goes is the raw output that "Recalculate analytics", the
# process tree and the RAW ZIP export read from disk. 0 = keep forever.
# JOB_OUTPUT_RETENTION_DAYS=90

# Upper bound on matched events read from one job's raw tool output per analytics pass.
# Bounds worker CPU (and process-tree memory) on a pathologically large job. Findings are
# unaffected — they come from the tools; analytics and the timelines describe a prefix.
# MAX_PARSE_EVENTS=250000

# Anonymous uploads — max requests per client IP per minute, shared fleet-wide via Redis
# (0 = unlimited). Upload admission requires Redis for shared capacity reservations.
# UPLOAD_RATE_LIMIT_PER_MINUTE=30
# Cookie and token uploads share a quota per creator (0 disables each rate).
AUTHENTICATED_UPLOAD_RATE_LIMIT_PER_MINUTE=60
PREVIEW_RATE_LIMIT_PER_MINUTE=120
# Shared concurrent upload limit; reserves temporary disk before parsing each request.
UPLOAD_MAX_CONCURRENT=4

# POST /auth/cookie/login — max requests per client IP per minute (0 = unlimited).
# LOGIN_RATE_LIMIT_PER_MINUTE=20

# POST /jobs/resubmit — max requests per client IP per minute (0 = unlimited).
# RESUBMIT_RATE_LIMIT_PER_MINUTE=10


# HSTS — only enable when serving over HTTPS (e.g. behind Caddy proxy profile).
# ENABLE_HSTS=false
# HSTS_MAX_AGE=63072000

# ── Reverse-proxy client IP handling ──────────────────────────────────────
# Trust X-Forwarded-For / Forwarded headers for the real client IP, but only when the
# direct peer matches TRUSTED_PROXY_CIDRS. Leave off unless behind a known proxy.
# TRUST_PROXY_HEADERS=false
# Comma-separated CIDRs allowed to supply forwarded headers. Use "*" only when the app is
# reachable solely through trusted ingress.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ── Intel: API tokens, enrichment, TAXII ──────────────────────────────────
# Fernet key for encrypting stored enrichment API tokens at rest. Defaults to SECRET_KEY
# when unset; rotating either value breaks existing encrypted blobs.
# ENRICHMENT_ENCRYPTION_KEY=
# Rate limit for token-authenticated IOC feed + TAXII requests (per token hash per minute).
# API_TOKEN_RATE_LIMIT_PER_MINUTE=120
# Enable the optional read-only TAXII 2.1 server at /taxii2/ (off by default).
# TAXII_ENABLED=false
# Outbound live-enrichment request rate limit per service per minute (0 = unlimited).
# ENRICHMENT_RATE_LIMIT_PER_MINUTE=30
# Require enrichment endpoints to be publicly-routable. Defaults to true, unlike the
# webhook and AI equivalents: a threat-intel API is on the public internet by definition,
# so a private address there is a red flag rather than the normal case. Set false to reach
# a self-hosted MISP/OpenCTI on your own network, or a local stub while you work out a
# template. Cloud metadata addresses stay blocked either way.
# ENRICHMENT_REQUIRE_PUBLIC_HOST=true

# ── Watch-rule webhooks ────────────────────────────────────────────────────
# Members create their own watch rules and may point them at their own webhook URL.
# By default private/internal hosts are permitted, because self-hosted receivers
# (Mattermost, n8n, an internal SIEM) live on RFC1918. That does mean any member can
# make the worker issue a POST to an address on your internal network.
#
# Set this to true on any deployment whose members you do not fully trust: it restricts
# webhook targets to publicly-routable addresses. The cloud metadata endpoint is refused
# either way. See docs/security.md#watch-rule-webhooks.
# WEBHOOK_REQUIRE_PUBLIC_HOST=false
# Per-request timeout, seconds.
# WEBHOOK_TIMEOUT_SECONDS=5
# Deliveries per rule per minute (0 = unlimited). Over the limit is recorded, not retried.
# WEBHOOK_RATE_LIMIT_PER_MINUTE=10
# Retries after a network error, timeout, 5xx or 429. Every other 4xx is terminal.
# Backoff is 60s/120s/240s.
# WEBHOOK_MAX_RETRIES=3
# Days to keep the webhook delivery log (pruned daily at 04:15 UTC; 0 = keep forever).
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Maximum enabled watch rules per user.
# WATCH_RULES_MAX_PER_USER=50

# A rule list (Rules → Lists) can name a source URL and be re-fetched on a schedule, so a
# list whose upstream moves — dynamic-DNS providers, paste sites, a TLD list — stays current
# without anyone remembering to paste a file in.
#
# Stricter than WEBHOOK_REQUIRE_PUBLIC_HOST above, and deliberately: a feed is fetched with
# nobody watching, and the reason to point one at an internal address is much rarer than the
# reason to point a webhook receiver at one. Set false for an internal mirror of a public
# list. The cloud metadata endpoint is refused either way, redirects are not followed, and
# the connection is pinned to a validated IP.
# RULE_LIST_REQUIRE_PUBLIC_HOST=true
# Per-request timeout, seconds.
# RULE_LIST_FETCH_TIMEOUT_SECONDS=15
# Largest feed that will be read. A list holds at most 2,000 values of 200 characters, so a
# legitimate feed is well under this; the cap stops a mistyped URL streaming a disk image
# into a worker.
# RULE_LIST_FETCH_MAX_BYTES=1048576

# ── AI job analysis ────────────────────────────────────────────────────────
# Off until an admin both adds a provider on /admin/ai and turns "AI Analysis" on in
# /admin/settings. Nothing is ever sent to a model automatically — a member clicks a
# button on one job. Everything about a provider (base URL, model, API token, timeout,
# system prompt) is a database row edited on that page; only the deployment-wide policy
# below lives in .env.
#
# A provider's base URL may point at a private or internal address by default: the
# reference setup is a local Ollama on http://localhost:11434/v1, which a public-only
# guard would reject outright. Cloud metadata addresses are refused either way, the
# connection is pinned to the address that passed the check, and redirects are not
# followed. Set this to true where an admin account is not fully trusted — the twin of
# WEBHOOK_REQUIRE_PUBLIC_HOST. See docs/security.md#ai-job-analysis.
# AI_REQUIRE_PUBLIC_HOST=false
# Analysis runs one user may start per minute (0 = unlimited). Lower than the other
# limits on purpose: one click spends money or occupies a GPU for minutes.
# AI_RATE_LIMIT_PER_MINUTE=10
# Default evidence-brief size for job and case AI analysis, in characters. Each provider
# can override the job and case limits separately on /admin/ai. System prompts are separate.
# Oversized briefs omit evidence and state that the model's view is partial.
# AI_MAX_PROMPT_CHARS=60000

# ── Reverse Proxy (optional) ──────────────────────────────────────────────
# Enable the built-in Caddy reverse proxy:
#   1. Add "proxy" to COMPOSE_PROFILES above
#   2. Set DOMAIN to the name people will use
#   3. Pick how TLS is terminated with PROXY_TLS below
#
# Or skip all of the above: `./logstotal proxy:enable` sets this whole block for you
# (plus COOKIE_INSECURE/ENABLE_HSTS below) — see docs/install/https.md.
#
# DOMAIN=logs.example.com
# WEB_PORT=127.0.0.1:8000:8000
#
# How the proxy terminates TLS. Default "acme".
#   acme      Let's Encrypt for a PUBLIC domain. Needs DNS pointing here and ports 80+443
#             reachable from the internet; set ACME_EMAIL for expiry notices.
#   internal  Caddy's own CA — no DNS, no port 80, no internet. This is the answer for an
#             internal or air-gapped network. Clients must install the root certificate,
#             which Caddy writes inside the caddy_data volume at
#             /data/caddy/pki/authorities/local/root.crt. Leave ENABLE_HSTS=false: a
#             browser that has not installed the root cannot click past a pinned failure.
#   custom    Your own certificate — put the files in ./certs (gitignored, never packaged)
#             and name them below by their in-container path.
#   off       Plain HTTP through Caddy, for a network where something in front already
#             terminates TLS. Requires COOKIE_INSECURE=true, or login silently fails.
# PROXY_TLS=acme
# ACME_EMAIL=admin@example.com          # acme only
# PROXY_TLS_CERT=/etc/caddy/certs/fullchain.pem   # custom only
# PROXY_TLS_KEY=/etc/caddy/certs/privkey.pem      # custom only

# ── HTTP Basic Auth (optional, requires proxy) ────────────────────────────
# Protect the entire app behind a username/password prompt.
#
# Step 1 — Generate the password hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
#
# Step 2 — Paste the hash below, but with SINGLE QUOTE to avoid Docker Compose variable expansion.
#
# Example:
#   caddy hash-password outputs → $2a$14$E2EsFJsmmVIXFKbSJx8F5uiYlHjdSm5lHPH5bGCfEJpXQePAqVHe
#   write it here as            → '$2a$14$E2EsFJsmmVIXFKbSJx8F5uiYlHjdSm5lHPH5bGCfEJpXQePAqVHe'
#
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH='$2a$14$E2EsFJsmmVIXFKbSJx8F5uiYlHjdSm5lHPH5bGCfEJpXQePAqVHe'
